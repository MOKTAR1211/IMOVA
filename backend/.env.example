PORT=5000

# Base de données PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=immo229
DB_PASSWORD=votre_mot_de_passe_secret
DB_PORT=5432

# Clé secrète pour les jetons JWT (générer une chaîne aléatoire d'au moins 32 caractères)
JWT_SECRET=

# Configuration Cloudinary (optionnel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL du frontend autorisé pour CORS
FRONTEND_URL=http://localhost:5173

# SMTP obligatoire en production pour confirmer les comptes et réinitialiser les mots de passe
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# MTN MoMo Collection (valeurs et identifiants fournis au compte marchand)
MTN_MOMO_API_BASE_URL=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_COUNTRY_CODE=229
MTN_MOMO_CURRENCY=XOF
# URL publique de l'API ; paiement indisponible tant que les identifiants MTN ne sont pas renseignés
BACKEND_PUBLIC_URL=
